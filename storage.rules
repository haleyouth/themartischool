rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }
    function role() { return isSignedIn() ? request.auth.token.get('role', 'none') : 'none'; }
    function isAdmin() { return role() == 'director' || role() == 'principal'; }
    function isStaff() { return isAdmin() || role() == 'teacher'; }
    function isActive() { return isSignedIn() && request.auth.token.get('active', false) == true; }

    function isImage() { return request.resource.contentType.matches('image/.*'); }
    function isDocument() {
      return request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*');
    }
    function underSize(mb) { return request.resource.size < mb * 1024 * 1024; }

    // Profile photos — a user manages their own; admins may fix any.
    match /avatars/{userId}/{fileName} {
      allow read: if isActive();
      allow write: if isActive() && (request.auth.uid == userId || isAdmin())
                   && isImage() && underSize(5);
      allow delete: if isActive() && (request.auth.uid == userId || isAdmin());
    }

    // Attachments on performance reports — staff write, and reads are gated to
    // staff. Students reach their own report attachments through a signed URL
    // issued by a Cloud Function, so no student read rule is needed here.
    match /reports/{reportId}/{fileName} {
      allow read: if isActive() && isStaff();
      allow write: if isActive() && isStaff() && isDocument() && underSize(20);
      allow delete: if isActive() && isStaff();
    }

    // Message attachments.
    match /messages/{conversationId}/{fileName} {
      allow read: if isActive();
      allow write: if isActive() && isDocument() && underSize(20);
      allow delete: if isActive() && isAdmin();
    }

    // Class materials such as syllabi.
    match /classes/{classId}/{fileName} {
      allow read: if isActive();
      allow write: if isActive() && isStaff() && isDocument() && underSize(50);
      allow delete: if isActive() && isStaff();
    }

    // Generated exports and report PDFs are written by the Admin SDK only.
    match /exports/{fileName} {
      allow read: if isActive() && role() == 'director';
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
